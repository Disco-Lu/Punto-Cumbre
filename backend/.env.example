# ==============================================================================
# Punto Cumbre API — Environment Variables Configuration
# ==============================================================================

# Entorno: development | production | test
ENVIRONMENT=development
PORT=8000
DEBUG=True

# Orígenes CORS permitidos (Formato JSON array)
# Incluye el origen del frontend (Next.js) de tu compañera
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# Base de Datos (Supabase / PostgreSQL)
# Conexión asíncrona mediante asyncpg (postgresql+asyncpg://...)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:TU_PASSWORD_AQUI@db.TU_PROYECTO.supabase.co:5432/postgres

# Parámetros Green Software: Connection Pooling
# Evitan abrir/cerrar sockets SSL continuamente, reduciendo consumo de CPU y red
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ------------------------------------------------------------------------------
# Seguridad y Autenticación (Admin JWT)
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=cambiar_esta_clave_por_una_cadena_segura_de_al_menos_32_caracteres
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ------------------------------------------------------------------------------
# Notificaciones por Correo (SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notificaciones@puntocumbre.cl
SMTP_PASSWORD=
SMTP_FROM_EMAIL=notificaciones@puntocumbre.cl

# ------------------------------------------------------------------------------
# Almacenamiento de Archivos e Imágenes de Equipos
# ------------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_IMAGE_SIZE_MB=5
